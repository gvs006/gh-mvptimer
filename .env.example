# Supabase — Project Settings › API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# A chave SECRETA — "secret key" (sb_secret_...) no painel novo, ou a
# service_role key no antigo. NUNCA a publishable/anon.
# Ela ignora RLS e só pode existir no servidor: nunca prefixe com
# NEXT_PUBLIC_, nunca importe em componente de cliente.
SUPABASE_SERVICE_ROLE_KEY=

# Assina o cookie de sessão. Mínimo 32 caracteres. Gere com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Trocar este valor invalida todas as sessões de todas as guilds de uma vez —
# é a chave-mestra de emergência.
SESSION_SECRET=
